[user]
	name = Robert Anderson
	email = robert@noisysocks.com
	signingkey = ~/.ssh/id_ed25519.pub
[init]
	defaultBranch = main
[pull]
	ff = only
[push]
	default = current
[commit]
	gpgsign = true
[gpg]
	format = ssh
[alias]
	co = checkout
	cp = cherry-pick
	st = status
[includeIf "gitdir:**/duckduckgo/"]
	path = .ddg-gitconfig
