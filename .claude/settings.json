{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "effortLevel": "high",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/format-if-available.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "asana-company-context@duckduckgo-plugins": true,
    "asana-formatting@duckduckgo-plugins": true,
    "asana-project-artifacts@duckduckgo-plugins": true,
    "cursor-cloud-agents@duckduckgo-plugins": true
  },
  "tui": "fullscreen"
}
